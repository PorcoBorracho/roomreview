# ---------- Supabase ----------
# Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave PÚBLICA (publishable "sb_publishable_..." o la antigua "anon").
# Es segura en el navegador: con el esquema incluido no puede leer ni escribir nada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clave SECRETA (secret "sb_secret_..." o la antigua "service_role"). NUNCA en el frontend.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ---------- Contraseñas (hashes scrypt) ----------
# Genera cada una con:  npm run hash-password
ADMIN_PASSWORD_HASH=
VIEWER_PASSWORD_HASH=

# ---------- Sesión ----------
# Cadena aleatoria de 32+ bytes:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------- Cloudflare Turnstile (captcha gratuito) ----------
# Claves de PRUEBA para desarrollo local (siempre pasan). En producción usa las tuyas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------- Cron de limpieza (Vercel lo envía automáticamente) ----------
CRON_SECRET=
